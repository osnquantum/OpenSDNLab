{% extends "layout/base.html" %}

{% block content %}

<style>

.topology-page{
    max-width:1600px;
    margin:0 auto;
}

.topology-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:24px;
}

.topology-title h1{
    margin:0 0 8px 0;
    font-size:28px;
}

.topology-title p{
    margin:0;
    color:#94a3b8;
}

.topology-status{
    display:flex;
    gap:10px;
    align-items:center;
    flex-wrap:wrap;
}

.status-badge{
    padding:8px 12px;
    border-radius:999px;
    background:#0f172a;
    border:1px solid #334155;
    color:#94a3b8;
    font-size:13px;
}

.status-badge.ready{
    color:#22c55e;
    border-color:#166534;
}

.topology-workspace{
    display:grid;
    grid-template-columns:260px minmax(0,1fr);
    gap:18px;
    align-items:start;
}

.topology-panel{
    background:#111827;
    border:1px solid #334155;
    border-radius:14px;
    overflow:hidden;
}

.panel-header{
    padding:16px 18px;
    border-bottom:1px solid #334155;
}

.panel-header h2,
.panel-header h3{
    margin:0;
    font-size:16px;
    color:#e5e7eb;
}

.panel-header p{
    margin:5px 0 0 0;
    color:#64748b;
    font-size:13px;
}

.panel-body{
    padding:16px;
}

.tool-section{
    margin-bottom:22px;
}

.tool-section:last-child{
    margin-bottom:0;
}

.tool-label{
    display:block;
    margin-bottom:10px;
    color:#94a3b8;
    font-size:12px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:.05em;
}

.controller-select{
    width:100%;
    padding:11px 12px;
    background:#0f172a;
    color:#e5e7eb;
    border:1px solid #334155;
    border-radius:8px;
    outline:none;
}

.tool-button{
    width:100%;
    padding:11px 12px;
    margin:0 0 8px 0;
    border-radius:8px;
    border:1px solid #334155;
    background:#1e293b;
    color:#e5e7eb;
    cursor:pointer;
    text-align:left;
    font-size:14px;
    transition:.2s;
}

.tool-button:hover{
    background:#334155;
    border-color:#38bdf8;
}

.tool-button.primary{
    background:#2563eb;
    border-color:#2563eb;
    text-align:center;
    font-weight:bold;
}

.tool-button.primary:hover{
    background:#1d4ed8;
}

.tool-button.danger{
    color:#fca5a5;
}

.tool-button.active{
    border-color:#38bdf8;
    background:#172554;
    color:#7dd3fc;
}

.batch-input{
    width:100%;
    box-sizing:border-box;
    padding:10px;
    background:#0f172a;
    color:#e5e7eb;
    border:1px solid #334155;
    border-radius:8px;
    margin-bottom:10px;
}

.canvas-panel{
    min-width:0;
}

.canvas-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    padding:16px 18px;
    border-bottom:1px solid #334155;
    flex-wrap:wrap;
}

.canvas-toolbar h2{
    margin:0;
    font-size:17px;
}

.canvas-meta{
    color:#64748b;
    font-size:13px;
}

#canvas{
    height:650px;
    margin:0;
    background:
        linear-gradient(rgba(51,65,85,.35) 1px, transparent 1px),
        linear-gradient(90deg, rgba(51,65,85,.35) 1px, transparent 1px),
        #0b1220;
    background-size:24px 24px;
    border:0;
    position:relative;
    overflow:hidden;
}

.device{
    padding:13px 16px;
    border-radius:10px;
    cursor:move;
    background:#2563eb;
    border:1px solid rgba(255,255,255,.15);
    box-shadow:0 8px 20px rgba(0,0,0,.25);
    color:white;
    font-size:13px;
    min-width:90px;
    text-align:center;
}

.device.controller{
    background:#dc2626;
}

.device.switch{
    background:#059669;
}

.output-panel{
    margin-top:18px;
}

#output{
    margin:0;
    padding:18px;
    min-height:180px;
    max-height:320px;
    overflow:auto;
    background:#020617;
    border:0;
    color:#cbd5e1;
    font-family:Consolas,monospace;
    font-size:13px;
}

.topology-footer{
    margin-top:18px;
    display:grid;
    grid-template-columns:1fr auto;
    gap:18px;
    align-items:center;
}

.footer-info{
    color:#64748b;
    font-size:13px;
}

.footer-actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.footer-button{
    padding:11px 16px;
    border-radius:8px;
    border:1px solid #334155;
    background:#1e293b;
    color:#e5e7eb;
    cursor:pointer;
}

.footer-button:hover{
    background:#334155;
}

.footer-button.save{
    border-color:#0284c7;
    color:#7dd3fc;
}

.footer-button.run{
    background:#2563eb;
    border-color:#2563eb;
    color:white;
    font-weight:bold;
}

@media(max-width:1050px){

    .topology-workspace{
        grid-template-columns:1fr;
    }

    .topology-sidebar{
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:18px;
    }

}

@media(max-width:700px){

    .topology-header{
        flex-direction:column;
    }

    .topology-sidebar{
        grid-template-columns:1fr;
    }

    #canvas{
        height:500px;
    }

    .topology-footer{
        grid-template-columns:1fr;
    }

}


