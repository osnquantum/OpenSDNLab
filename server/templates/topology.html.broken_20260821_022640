    if(!topologies.length){

        body.innerHTML = `
            <tr>
                <td colspan="6"
                    class="topology-empty">
                    No matching topology found.
                </td>
            </tr>
        `;

        return;

    }

    body.innerHTML =
        topologies.map(function(topology){

            const id =
                escapeSavedTopology(
                    topology.topology_id
                );

            const name =
                escapeSavedTopology(
                    topology.name ||
                    "Unnamed Topology"
                );

            const controller =
                escapeSavedTopology(
                    topology.controller ||
                    "-"
                );

            const nodes =
                escapeSavedTopology(
                    topology.nodes || 0
                );

            const links =
                escapeSavedTopology(
                    topology.links || 0
                );

            return `
                <tr>
                    <td class="saved-topology-name">
                        ${name}
                    </td>

                    <td>
                        ${controller}
                    </td>

                    <td>
                        ${nodes}
                    </td>

                    <td>
                        ${links}
                    </td>

                    <td>
                        <span class="topology-id">
                            ${id}
                        </span>
                    </td>

                    <td>
                        <button
                            type="button"
                            class="footer-button"
                            onclick="loadSavedTopology('${id}')"
                        >
                            Load
                        </button>
                    </td>
                </tr>
            `;

        }).join("");

}


function filterSavedTopologies(){

    const search =
        document.getElementById(
            "savedTopologySearch"
        );

    if(!search){

        renderSavedTopologies(
            savedTopologiesData
        );

        return;

    }

    const query =
        search.value
            .trim()
            .toLowerCase();

    const filtered =
        savedTopologiesData.filter(
            function(topology){

                return [
                    topology.name,
                    topology.controller,
                    topology.topology_id
                ].some(function(value){

                    return String(
                        value || ""
                    )
                    .toLowerCase()
                    .includes(query);

                });

            }
        );

    renderSavedTopologies(filtered);

}


/*
 * Load table when page opens.
 */
document.addEventListener(
    "DOMContentLoaded",
    function(){

        loadSavedTopologies();

        const search =
            document.getElementById(
                "savedTopologySearch"
            );

        if(search){

            search.addEventListener(
                "input",
                filterSavedTopologies
            );

        }

    }
);


</script>

