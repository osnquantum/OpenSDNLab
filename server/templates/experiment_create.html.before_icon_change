<script>

let currentBatchJob = null;


/* ========================================================= */
/* PANEL SWITCHING */
/* ========================================================= */

function showExperimentPanel(panel, button){

    document
        .querySelectorAll(".experiment-panel")
        .forEach(function(element){

            element.classList.remove("active");

        });


    document
        .querySelectorAll(".experiment-tab")
        .forEach(function(element){

            element.classList.remove("active");

        });


    document
        .getElementById(panel)
        .classList.add("active");


    button.classList.add("active");

}


/* ========================================================= */
/* CONFIGURATION SUMMARY */
/* ========================================================= */

function updateExperimentSummary(){

    const topology =
        document.getElementById("topology").value;

    const controller =
        document.getElementById("controller").value;

    const hosts =
        document.getElementById("hosts").value;

    const switches =
        document.getElementById("switches").value;

    const protocol =
        document.getElementById("protocol").value;

    const runs =
        document.getElementById("runs").value;


    document.getElementById(
        "summary_topology"
    ).textContent =
        topology.charAt(0).toUpperCase() +
        topology.slice(1);


    document.getElementById(
        "summary_controller"
    ).textContent =
        controller === "osken" ?
        "OS-Ken" :
        "Ryu";


    document.getElementById(
        "summary_network"
    ).textContent =
        hosts +
        " Hosts · " +
        switches +
        " Switches";


    document.getElementById(
        "summary_execution"
    ).textContent =
        protocol.toUpperCase() +
        " · " +
        runs +
        " Runs";

}


[
    "topology",
    "controller",
    "hosts",
    "switches",
    "protocol",
    "runs"
].forEach(function(id){

    document
        .getElementById(id)
        .addEventListener(
            "input",
            updateExperimentSummary
        );


    document
        .getElementById(id)
        .addEventListener(
            "change",
            updateExperimentSummary
        );

});


/* ========================================================= */
/* RESET FORM */
/* ========================================================= */

function resetExperimentForm(){

    document.getElementById("name").value =
        "Web Experiment";

    document.getElementById("topology").value =
        "linear";

    document.getElementById("hosts").value =
        "2";

    document.getElementById("switches").value =
        "2";

    document.getElementById("controller").value =
        "osken";

    document.getElementById("protocol").value =
        "tcp";

    document.getElementById("runs").value =
        "10";


    document.getElementById(
        "experiment_result"
    ).textContent =
        "Configuration reset.";


    updateExperimentSummary();

}


/* ========================================================= */
/* STANDARD EXPERIMENT */
/* ========================================================= */

async function startExperiment(){

    const payload = {

        name:
            document.getElementById("name").value,

        topology:
            document.getElementById("topology").value,

        hosts:
            Number(
                document.getElementById("hosts").value
            ),

        switches:
            Number(
                document.getElementById("switches").value
            ),

        controller:
            document.getElementById("controller").value,

        protocol:
            document.getElementById("protocol").value,

        runs:
            Number(
                document.getElementById("runs").value
            )

    };


    const result =
        document.getElementById(
            "experiment_result"
        );


    const consoleState =
        document.getElementById(
            "console_state"
        );


    result.textContent =
        "Submitting experiment...";


    consoleState.textContent =
        "SUBMITTING";


    try{

        const response =
            await fetch(
                "/api/experiments/run",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(payload)
                }
            );


        const text =
            await response.text();


        let data;

        try{

            data = JSON.parse(text);

        }
        catch(error){

            throw new Error(
                "Server returned non-JSON response: " +
                text.substring(0,200)
            );

        }


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.message ||
                "Failed to start experiment"
            );

        }


        const job =
            data.data &&
            data.data.job_id;


        const experimentId =
            data.data &&
            data.data.experiment_id;


        if(experimentId){

            window.currentExperimentId =
                experimentId;

            sessionStorage.setItem(
                "currentExperimentId",
                experimentId
            );

        }


        result.textContent =
            "Experiment started successfully.\n" +
            "Job ID: " +
            job;


        consoleState.textContent =
            "RUNNING";


        if(job){

            window.location.href =
                "/running/" + job;

        }

    }
    catch(error){

        result.textContent =
            "Failed to start experiment: " +
            error.message;


        consoleState.textContent =
            "ERROR";

    }

}


/* ========================================================= */
/* BATCH EXECUTION */
/* ========================================================= */

async function runBatch(){

    const result =
        document.getElementById(
            "batch_result"
        );


    result.textContent =
        "Preparing batch...";


    await createBatch();


    if(!currentBatchJob){

        return;

    }


    await startBatch();

}


async function createBatch(){

    const experimentId =
        window.currentExperimentId ||
        sessionStorage.getItem(
            "currentExperimentId"
        );


    const runs =
        parseInt(
            document.getElementById(
                "batch_runs"
            ).value
        );


    const result =
        document.getElementById(
            "batch_result"
        );


    if(!experimentId){

        result.textContent =
            "No experiment selected. Start a standard experiment first.";

        return;

    }


    try{

        const response =
            await fetch(
                "/api/batch/create",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            experiment_id:
                                experimentId,

                            runs:
                                runs

                        })

                }
            );


        const data =
            await response.json();


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.message ||
                "Failed to create batch"
            );

        }


        currentBatchJob =
            data.job &&
            data.job.job_id;


        if(!currentBatchJob){

            throw new Error(
                "Batch job ID was not returned"
            );

        }


        document.getElementById(
            "batch_job"
        ).textContent =
            currentBatchJob;


        document.getElementById(
            "batch_status"
        ).textContent =
            "CREATED";


        result.textContent =
            "Batch created successfully.";

    }
    catch(error){

        result.textContent =
            "Batch creation failed: " +
            error.message;

    }

}


async function startBatch(){

    const result =
        document.getElementById(
            "batch_result"
        );


    try{

        const response =
            await fetch(
                "/api/batch/start/" +
                currentBatchJob,
                {
                    method:"POST"
                }
            );


        const data =
            await response.json();


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.message ||
                "Failed to start batch"
            );

        }


        result.textContent =
            "Batch execution started.";

    }
    catch(error){

        result.textContent =
            "Failed to start batch: " +
            error.message;

    }

}


async function updateBatchStatus(){

    if(!currentBatchJob){

        return;

    }


    try{

        const response =
            await fetch(
                "/api/batch/status/" +
                currentBatchJob
            );


        const data =
            await response.json();


        const job =
            data.job;


        if(!job){

            return;

        }


        const statusElement =
            document.getElementById(
                "batch_status"
            );


        document.getElementById(
            "batch_job"
        ).textContent =
            currentBatchJob;


        statusElement.textContent =
            job.status ||
            "-";


        statusElement.classList.remove(
            "status-running",
            "status-completed",
            "status-failed"
        );


        if(job.status === "RUNNING"){

            statusElement.classList.add(
                "status-running"
            );

        }
        else if(
            job.status === "COMPLETED"
        ){

            statusElement.classList.add(
                "status-completed"
            );

        }
        else if(
            job.status === "FAILED"
        ){

            statusElement.classList.add(
                "status-failed"
            );

        }


        document.getElementById(
            "batch_progress"
        ).textContent =
            (job.current_run || 0) +
            "/" +
            (job.total_runs || 0);


        document.getElementById(
            "batch_success"
        ).textContent =
            job.successful ||
            0;


        document.getElementById(
            "batch_failed"
        ).textContent =
            job.failed ||
            0;

    }
    catch(error){

        console.error(
            "Batch status update failed:",
            error
        );

    }

}


setInterval(
    updateBatchStatus,
    3000
);


updateExperimentSummary();

</script>

{% endblock %}
