<script>

async function drawTopology(){

    const response = await fetch(
        "/api/topology/generate",
        {
            method:"POST",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify({

                type:"linear",
                hosts:5,
                switches:2,
                controller:"os-ken"

            })
        }
    );


    const data = await response.json();


    let canvas =
    document.getElementById("canvas");


    canvas.innerHTML="";


    let topology=data.topology;


    topology.nodes.forEach(
        node=>{

            let div=document.createElement("div");

            div.className="node";


            if(node.type==="switch"){
                div.style.background="#16a34a";
            }


            div.innerHTML=node.id;


            canvas.appendChild(div);

        }
    );


    canvas.innerHTML += "<br><br>";


    topology.links.forEach(
        link=>{

            canvas.innerHTML +=
            "<div>" +
            link.source +
            " -------- " +
            link.target +
            "</div>";

        }
    );


}


drawTopology();


</script>




<style>

#editor{

height:500px;
background:#0f172a;
