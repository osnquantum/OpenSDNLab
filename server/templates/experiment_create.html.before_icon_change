                    </div>


                    <div class="summary-list">

                        <div class="summary-item">
                            <span>Topology</span>
                            <strong id="summary_topology">
                                Linear
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Controller</span>
                            <strong id="summary_controller">
                                OS-Ken
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Network Size</span>
                            <strong id="summary_network">
                                2 Hosts · 2 Switches
