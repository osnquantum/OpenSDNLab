<!DOCTYPE html>

<html>

<head>

<title>OpenSDNLab Topology Designer</title>

<script src="/static/js/jsplumb.min.js"></script>


<style>

body{
background:#111827;
color:white;
font-family:Arial;
}


.card{
background:#1f2937;
padding:20px;
margin:20px;
border-radius:10px;
}


button{

padding:10px;
margin:5px;
cursor:pointer;

}


#canvas{

height:600px;
background:#0f172a;
border:1px solid white;
position:relative;

}


.device{

position:absolute;

padding:15px;

border-radius:8px;

cursor:move;

background:#2563eb;

}


.device.switch{

background:#16a34a;

}


.device.controller{

background:#dc2626;

}


pre{

background:#020617;
padding:15px;

}

</style>

</head>


<body>


<h1>
OpenSDNLab Topology Designer
</h1>


<div class="card">


<h2>
Controller Configuration
</h2>


<select id="controller">


<option>
OS-Ken
</option>


<option>
Ryu
</option>


<option>
ONOS
</option>


</select>


</div>



<div class="card">


<h2>
Topology Controls
</h2>


<button onclick="addHost()">
+ Add Host
</button>


<button onclick="addSwitch()">
+ Add Switch
</button>


<button onclick="saveTopology()">
Save Topology
</button>


</div>



<div class="card">


<h2>
Topology Canvas
</h2>


<div id="canvas">

</div>


</div>



<div class="card">

<h2>
Topology JSON
</h2>


<pre id="output">
{}
</pre>


</div>



<script>


let topologyState={

nodes:[],

links:[],

controller:"OS-Ken"

};



let hostCounter=0;

let switchCounter=0;



function addHost(){


hostCounter++;


let id="h"+hostCounter;


topologyState.nodes.push({

id:id,

type:"host"

});


createNode(id,"host");


updateJSON();


}




function addSwitch(){


switchCounter++;


let id="s"+switchCounter;


topologyState.nodes.push({

id:id,

type:"switch"

});


createNode(id,"switch");


updateJSON();


}




function createNode(id,type){


let canvas=document.getElementById("canvas");


let node=document.createElement("div");


node.id=id;


node.className="device "+type;


node.innerHTML=id;



node.style.left=

(50+Math.random()*400)+"px";


node.style.top=

(50+Math.random()*400)+"px";



canvas.appendChild(node);



jsPlumb.draggable(node);


}




function saveTopology(){


topologyState.controller=

document.getElementById("controller").value;



localStorage.setItem(

"opensdnlab_topology",

JSON.stringify(topologyState)

);



updateJSON();


alert("Topology saved");

}




function updateJSON(){


document.getElementById("output").innerHTML=

JSON.stringify(

topologyState,

null,

4

);


}



</script>


</body>


</html>
