<!DOCTYPE html>

<html>

<head>

<title>OpenSDN Topology Builder</title>


<style>

body{
background:#111827;
color:white;
font-family:Arial;
}


.card{

background:#1f2937;
padding:20px;
margin:20px;
border-radius:10px;

}


input,select{

padding:8px;
margin:5px;

}


.node{

background:#2563eb;
padding:15px;
border-radius:50%;
display:inline-block;
margin:20px;
min-width:40px;
text-align:center;

}


.link{

height:3px;
background:white;
width:100px;
display:inline-block;

}



#canvas{

height:500px;
background:#0f172a;
position:relative;
border:1px solid white;

}


.device{

position:absolute;
padding:15px;
border-radius:8px;
cursor:move;
background:#2563eb;

}


.device.switch{

background:#16a34a;

}


</style>



<script src="/static/js/jsplumb.min.js"></script>

</head>



<body>


<h1>
OpenSDN Topology Builder
</h1>



<div class="card">


<h2>
Network Configuration
</h2>


<label>
Topology
</label>

<select id="topologyType">

<option>
Linear
</option>

<option>
Tree
</option>

<option>
Star
</option>

</select>


<br>


<label>
Controller
</label>


<select id="controllerType">

<option>
Ryu
</option>

<option>
OS-Ken
</option>

<option>
ONOS
</option>

<option>
OpenDaylight
</option>


</select>


<br>


<label>
Bandwidth Mbps
</label>

<input value="100">


<br>


<label>
Delay ms
</label>

<input value="10">


<br>




</div>












<div class="card">

<h2>
Topology Controls
</h2>


<button onclick="addHost()">
+ Add Host
</button>


<button onclick="addSwitch()">
+ Add Switch
</button>


<button onclick="saveTopology()">
Save Topology
</button>


</div>

<div id="canvas">

</div>


</div>






<script>

let topologyState = {

    nodes: [],

    links: []

};








<style>

#editor{

height:500px;
background:#0f172a;
position:relative;

}


.device{

position:absolute;

padding:15px;

background:#2563eb;

border-radius:8px;

cursor:pointer;

}


.switch{

background:#16a34a;

}


.controller{

background:#dc2626;

}

</style>



<div class="card">

<h2>
Interactive Topology
</h2>


<div id="editor">



</div>


</div>






