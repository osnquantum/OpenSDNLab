"""
OpenSDNLab Topology-Aware SDN Controller
OpenFlow 1.3 / OS-Ken

Features:
- LLDP topology discovery
- Host location learning
- Global network graph
- Shortest-path forwarding
- End-to-end flow installation
- No normal data-plane flooding
"""

from collections import deque
import json
import os

from os_ken.base import app_manager
from os_ken.controller import ofp_event
from os_ken.controller.handler import (
    CONFIG_DISPATCHER,
    MAIN_DISPATCHER,
    DEAD_DISPATCHER,
    set_ev_cls,
)
from os_ken.ofproto import ofproto_v1_3
from os_ken.topology import event
from os_ken.topology.api import get_switch, get_link
from os_ken.lib.packet import packet
from os_ken.lib.packet import ethernet


class SimpleSwitch13(app_manager.OSKenApp):

    OFP_VERSIONS = [ofproto_v1_3.OFP_VERSION]

    def __init__(self, *args, **kwargs):
        super(SimpleSwitch13, self).__init__(*args, **kwargs)

        # Connected OpenFlow switches
        self.datapaths = {}

        # MAC -> {dpid, port}
        self.host_locations = {}

        # dpid -> {neighbor_dpid: out_port}
        self.graph = {}

        self.stats = {
            "switch_count": 0,
            "packet_in_count": 0,
            "flow_install_count": 0,
            "topology_switch_count": 0,
            "topology_link_count": 0,
        }

    ############################################################
    # RUNTIME STATS
    ############################################################

    def export_stats(self):

        path = "runtime/controller_stats/osken.json"

        os.makedirs(
            "runtime/controller_stats",
            exist_ok=True
        )

        with open(path, "w") as f:
            json.dump(
                self.stats,
                f,
                indent=4
            )

    ############################################################
    # TOPOLOGY DISCOVERY
    ############################################################

    def refresh_topology(self):

        switches = get_switch(self, None)
        links = get_link(self, None)

        self.graph = {}

        for switch in switches:

            dpid = switch.dp.id

            self.graph.setdefault(dpid, {})

            self.datapaths[dpid] = switch.dp

        for link in links:

            src_dpid = link.src.dpid
            dst_dpid = link.dst.dpid
            src_port = link.src.port_no

            self.graph.setdefault(src_dpid, {})

            self.graph[src_dpid][dst_dpid] = src_port

        self.stats["topology_switch_count"] = len(self.graph)
        self.stats["topology_link_count"] = len(links)

        self.export_stats()

        self.logger.info(
            "Topology updated: switches=%s links=%s",
            len(self.graph),
            len(links)
        )

        self.logger.info(
            "Network graph: %s",
            self.graph
        )

    ############################################################
    # SHORTEST PATH - BFS
    ############################################################

    def shortest_path(self, src, dst):

        if src == dst:
            return [src]

        if src not in self.graph:
            return None

        queue = deque([[src]])
        visited = {src}

        while queue:

            path = queue.popleft()

            current = path[-1]

            for neighbor in self.graph.get(current, {}):

                if neighbor == dst:
                    return path + [neighbor]

                if neighbor not in visited:

                    visited.add(neighbor)

                    queue.append(
                        path + [neighbor]
                    )

        return None

    ############################################################
    # FLOW MANAGEMENT
    ############################################################

    def add_flow(
        self,
        datapath,
        priority,
        match,
        actions
    ):

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        instructions = [
            parser.OFPInstructionActions(
                ofproto.OFPIT_APPLY_ACTIONS,
                actions
            )
        ]

        mod = parser.OFPFlowMod(
            datapath=datapath,
            priority=priority,
            match=match,
            instructions=instructions
        )

        datapath.send_msg(mod)

        self.stats["flow_install_count"] += 1

        self.export_stats()

    ############################################################
    # INSTALL PATH
    ############################################################

    def install_path(
        self,
        path,
        dst_mac,
        dst_port
    ):

        for index, dpid in enumerate(path):

            datapath = self.datapaths.get(dpid)

            if datapath is None:
                continue

            parser = datapath.ofproto_parser

            # Last switch -> destination host
            if index == len(path) - 1:

                out_port = dst_port

            else:

                next_switch = path[index + 1]

                out_port = self.graph[dpid].get(
                    next_switch
                )

            if out_port is None:
                self.logger.warning(
                    "No output port from %s",
                    dpid
                )
                continue

            match = parser.OFPMatch(
                eth_dst=dst_mac
            )

            actions = [
                parser.OFPActionOutput(
                    out_port
                )
            ]

            self.add_flow(
                datapath,
                priority=10,
                match=match,
                actions=actions
            )

            self.logger.info(
                "Installed flow: switch=%s "
                "dst=%s out_port=%s",
                dpid,
                dst_mac,
                out_port
            )

    ############################################################
    # SWITCH EVENTS
    ############################################################

    @set_ev_cls(
        ofp_event.EventOFPSwitchFeatures,
        CONFIG_DISPATCHER
    )
    def switch_features_handler(self, ev):

        datapath = ev.msg.datapath

        self.datapaths[
            datapath.id
        ] = datapath

        self.stats["switch_count"] = len(
            self.datapaths
        )

        self.export_stats()

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        # Table-miss:
        # Unknown packets go to controller.
        match = parser.OFPMatch()

        actions = [
            parser.OFPActionOutput(
                ofproto.OFPP_CONTROLLER,
                ofproto.OFPCML_NO_BUFFER
            )
        ]

        self.add_flow(
            datapath,
            priority=0,
            match=match,
            actions=actions
        )

        self.logger.info(
            "Switch connected: %s",
            datapath.id
        )

    ############################################################

    @set_ev_cls(
        ofp_event.EventOFPStateChange,
        [MAIN_DISPATCHER, DEAD_DISPATCHER]
    )
    def state_change_handler(self, ev):

        datapath = ev.datapath

        if ev.state == MAIN_DISPATCHER:

            self.datapaths[
                datapath.id
            ] = datapath

        elif ev.state == DEAD_DISPATCHER:

            if datapath.id in self.datapaths:

                del self.datapaths[
                    datapath.id
                ]

    ############################################################
    # LLDP TOPOLOGY EVENTS
    ############################################################

    @set_ev_cls(event.EventSwitchEnter)
    def switch_enter_handler(self, ev):

        self.logger.info(
            "Switch entered topology"
        )

        self.refresh_topology()

    ############################################################

    @set_ev_cls(event.EventSwitchLeave)
    def switch_leave_handler(self, ev):

        self.logger.info(
            "Switch left topology"
        )

        self.refresh_topology()

    ############################################################

    @set_ev_cls(event.EventLinkAdd)
    def link_add_handler(self, ev):

        self.logger.info(
            "Link added"
        )

        self.refresh_topology()

    ############################################################

    @set_ev_cls(event.EventLinkDelete)
    def link_delete_handler(self, ev):

        self.logger.info(
            "Link deleted"
        )

        self.refresh_topology()

    ############################################################
    # PACKET-IN
    ############################################################

    @set_ev_cls(
        ofp_event.EventOFPPacketIn,
        MAIN_DISPATCHER
    )
    def packet_in_handler(self, ev):

        self.stats["packet_in_count"] += 1

        msg = ev.msg
        datapath = msg.datapath

        dpid = datapath.id

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        in_port = msg.match["in_port"]

        pkt = packet.Packet(msg.data)

        eth = pkt.get_protocol(
            ethernet.ethernet
        )

        if eth is None:
            return

        src = eth.src
        dst = eth.dst

        # Ignore LLDP packets.
        if eth.ethertype == 0x88cc:
            return

        ########################################################
        # LEARN SOURCE HOST LOCATION
        ########################################################

        self.host_locations[src] = {
            "dpid": dpid,
            "port": in_port
        }

        self.logger.info(
            "Host learned: %s -> switch=%s port=%s",
            src,
            dpid,
            in_port
        )

        ########################################################
        # DESTINATION UNKNOWN
        #
        # Do NOT flood the whole network.
        ########################################################

        if dst not in self.host_locations:

            self.logger.info(
                "Destination unknown: %s. "
                "Waiting for host discovery.",
                dst
            )

            return

        ########################################################
        # DESTINATION KNOWN
        ########################################################

        dst_location = self.host_locations[dst]

        src_switch = dpid

        dst_switch = dst_location["dpid"]

        dst_port = dst_location["port"]

        path = self.shortest_path(
            src_switch,
            dst_switch
        )

        if not path:

            self.logger.warning(
                "No path found from %s to %s",
                src_switch,
                dst_switch
            )

            return

        self.logger.info(
            "Selected path: %s",
            path
        )

        ########################################################
        # INSTALL FLOWS ALONG PATH
        ########################################################

        self.install_path(
            path,
            dst,
            dst_port
        )

        ########################################################
        # FORWARD CURRENT PACKET
        ########################################################

        if len(path) == 1:

            out_port = dst_port

        else:

            next_switch = path[1]

            out_port = self.graph[
                src_switch
            ].get(
                next_switch
            )

        if out_port is None:
            return

        actions = [
            parser.OFPActionOutput(
                out_port
            )
        ]

        data = None

        if msg.buffer_id == ofproto.OFP_NO_BUFFER:

            data = msg.data

        out = parser.OFPPacketOut(
            datapath=datapath,
            buffer_id=msg.buffer_id,
            in_port=in_port,
            actions=actions,
            data=data
        )

        datapath.send_msg(out)
