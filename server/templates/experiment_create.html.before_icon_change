{% extends "layout/base.html" %}

{% block content %}

<style>

.experiment-page{
    max-width:1400px;
    margin:0 auto;
}

.page-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:28px;
}

.page-title{
    margin:0;
    font-size:28px;
}

.page-subtitle{
    margin:8px 0 0;
    color:#94a3b8;
}

.header-status{
    padding:10px 16px;
    border:1px solid #334155;
    background:#0f172a;
    border-radius:10px;
    color:#94a3b8;
    white-space:nowrap;
}

.header-status strong{
    color:#38bdf8;
}

.experiment-tabs{
    display:flex;
    gap:10px;
    margin-bottom:24px;
    flex-wrap:wrap;
}

.experiment-tab{
    padding:11px 18px;
    border:1px solid #334155;
    background:#0f172a;
    color:#94a3b8;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    transition:.2s;
}

.experiment-tab:hover{
    border-color:#38bdf8;
    color:#e2e8f0;
}

.experiment-tab.active{
    background:#2563eb;
    color:white;
    border-color:#2563eb;
}

.experiment-panel{
    display:none;
}

.experiment-panel.active{
    display:block;
}

.experiment-layout{
    display:grid;
    grid-template-columns:minmax(0,2fr) minmax(280px,1fr);
    gap:20px;
}

.experiment-card{
    background:#111827;
    border:1px solid #334155;
    border-radius:14px;
    padding:22px;
    margin-bottom:20px;
}

.card-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:15px;
    margin-bottom:22px;
}

.card-header h3{
    margin:0;
    color:#e5e7eb;
}

.card-header p{
    margin:6px 0 0;
    color:#64748b;
    font-size:14px;
}

.config-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px;
}

.field-group.full{
    grid-column:1 / -1;
}

.field-group label{
    display:block;
    margin-bottom:7px;
    color:#cbd5e1;
    font-size:14px;
    font-weight:600;
}

.field-help{
    margin-top:5px;
    color:#64748b;
    font-size:12px;
}

.field-group input,
.field-group select{
    width:100%;
    padding:11px 12px;
    box-sizing:border-box;
    background:#0b1220;
    border:1px solid #334155;
    border-radius:9px;
    color:#e5e7eb;
    outline:none;
}

.field-group input:focus,
.field-group select:focus{
    border-color:#38bdf8;
    box-shadow:0 0 0 2px rgba(56,189,248,.1);
}

.section-label{
    margin:24px 0 14px;
    padding-top:20px;
    border-top:1px solid #1e293b;
    color:#38bdf8;
    font-size:13px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:.08em;
}

.experiment-btn{
    padding:11px 20px;
    border:0;
    border-radius:9px;
    background:#2563eb;
    color:white;
    cursor:pointer;
    font-weight:bold;
    transition:.2s;
}

.experiment-btn:hover{
    background:#1d4ed8;
}

.experiment-btn.secondary{
    background:#1e293b;
    border:1px solid #334155;
}

.experiment-btn.secondary:hover{
    background:#334155;
}

.action-row{
    display:flex;
    gap:10px;
    align-items:center;
    margin-top:24px;
    flex-wrap:wrap;
}

.result-box{
    margin-top:18px;
    padding:14px;
    min-height:22px;
    background:#0b1220;
    border:1px solid #1e293b;
    border-radius:10px;
    color:#94a3b8;
    white-space:pre-wrap;
    font-family:Consolas,monospace;
    font-size:13px;
}

.summary-list{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.summary-item{
    padding:13px;
    background:#0b1220;
    border:1px solid #1e293b;
    border-radius:10px;
}

.summary-item span{
    display:block;
    color:#64748b;
    font-size:12px;
    margin-bottom:5px;
}

.summary-item strong{
    color:#e2e8f0;
    word-break:break-word;
}

.info-note{
    padding:14px;
    border-left:3px solid #38bdf8;
    background:#0b1220;
    border-radius:8px;
    color:#94a3b8;
    font-size:13px;
    line-height:1.6;
}

.status-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
    margin-top:20px;
}

.status-box{
    padding:16px;
    background:#0b1220;
    border:1px solid #334155;
    border-radius:10px;
}

.status-box span{
    display:block;
    color:#64748b;
    font-size:12px;
    margin-bottom:7px;
}

.status-box strong{
    display:block;
    color:#e2e8f0;
    word-break:break-word;
}

.status-running{
    color:#fbbf24 !important;
}

.status-completed{
    color:#22c55e !important;
}

.status-failed{
    color:#ef4444 !important;
}

.topology-preview{
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:240px;
    background:#0b1220;
    border:1px dashed #334155;
    border-radius:12px;
    color:#64748b;
    text-align:center;
    padding:20px;
}

.custom-actions{
    display:flex;
    gap:12px;
    margin-top:20px;
    flex-wrap:wrap;
}

@media(max-width:1100px){

    .experiment-layout{
        grid-template-columns:1fr;
    }

    .status-grid{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:700px){

    .page-header{
        flex-direction:column;
    }

    .config-grid{
        grid-template-columns:1fr;
    }

    .field-group.full{
        grid-column:auto;
    }

    .status-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:480px){

    .status-grid{
        grid-template-columns:1fr;
    }

}

</style>


