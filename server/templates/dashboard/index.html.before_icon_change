{% extends "layout/base.html" %}

{% block content %}

<style>

.dashboard-shell{
    max-width:1500px;
    margin:0 auto;
}

.dashboard-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:28px;
    padding-bottom:20px;
    border-bottom:1px solid var(--border-color, #334155);
}

.dashboard-title h1{
    margin:0;
    font-size:28px;
}

.dashboard-title p{
    margin:8px 0 0;
    color:#94a3b8;
}

.live-indicator{
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 16px;
    border:1px solid #334155;
    border-radius:999px;
    background:#0f172a;
    color:#cbd5e1;
}

.live-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#22c55e;
    box-shadow:0 0 12px #22c55e;
}

.dashboard-section{
    margin-bottom:24px;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
}

.section-heading h2{
    margin:0;
    font-size:18px;
}

.section-heading span{
    color:#64748b;
    font-size:13px;
}

.overview-grid{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:16px;
}

.status-card{
    background:#111827;
    border:1px solid #334155;
    border-radius:14px;
    padding:18px;
}

.status-card .label{
    display:block;
    color:#94a3b8;
    font-size:13px;
    margin-bottom:10px;
}

.status-card .value{
    font-size:22px;
    font-weight:700;
    color:#e5e7eb;
    word-break:break-word;
}

.status-card .value.small{
    font-size:15px;
}

.metrics-grid{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:16px;
}

.metric-card{
    background:linear-gradient(145deg,#111827,#0f172a);
    border:1px solid #334155;
    border-radius:14px;
    padding:20px;
}

.metric-label{
    color:#94a3b8;
    font-size:13px;
    display:block;
    margin-bottom:10px;
}

.metric-value{
    font-size:26px;
    font-weight:700;
    color:#38bdf8;
}

.metric-unit{
    color:#64748b;
    font-size:13px;
    margin-left:4px;
}

.dashboard-two-column{
    display:grid;
    grid-template-columns:1.25fr 1fr;
    gap:16px;
}

.panel{
    background:#111827;
    border:1px solid #334155;
    border-radius:14px;
    padding:20px;
}

.panel h2{
    margin:0 0 18px;
    font-size:18px;
}

.workflow-list{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.workflow-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:13px 14px;
    background:#0f172a;
    border:1px solid #1e293b;
    border-radius:10px;
}

.workflow-item span{
    color:#cbd5e1;
}

.workflow-item b{
    color:#38bdf8;
    font-size:12px;
}

.runtime-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.runtime-item{
    display:flex;
    justify-content:space-between;
    padding:12px 0;
    border-bottom:1px solid #1e293b;
}

.runtime-item:last-child{
    border-bottom:none;
}

.runtime-item span:first-child{
    color:#94a3b8;
}

.batch-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.batch-item{
    background:#0f172a;
    border:1px solid #1e293b;
    border-radius:10px;
    padding:12px;
}

.batch-item span{
    display:block;
    color:#64748b;
    font-size:12px;
    margin-bottom:6px;
}

.batch-item b{
    color:#e5e7eb;
    word-break:break-word;
}

.batch-item.wide{
    grid-column:1 / -1;
}

.readiness-box{
    line-height:1.8;
    color:#cbd5e1;
    background:#0f172a;
    border:1px solid #1e293b;
    border-radius:10px;
    padding:14px;
}

.history-wrapper{
    overflow-x:auto;
}

.history-table{
    width:100%;
    border-collapse:collapse;
    min-width:750px;
}

.history-table th{
    text-align:left;
    padding:12px;
    color:#94a3b8;
    font-size:12px;
    border-bottom:1px solid #334155;
}

.history-table td{
    padding:13px 12px;
    color:#cbd5e1;
    border-bottom:1px solid #1e293b;
}

.history-table tr:hover{
    background:#0f172a;
}

.history-table a{
    color:#38bdf8;
    text-decoration:none;
}

.history-table a:hover{
    text-decoration:underline;
}

@media(max-width:1100px){

    .overview-grid,
    .metrics-grid{
        grid-template-columns:repeat(2, minmax(0,1fr));
    }

    .dashboard-two-column{
        grid-template-columns:1fr;
    }

}

@media(max-width:700px){

    .dashboard-header{
        align-items:flex-start;
        flex-direction:column;
        gap:14px;
    }

    .overview-grid,
    .metrics-grid{
        grid-template-columns:1fr;
    }

}

</style>


<div class="dashboard-shell">

    <div class="dashboard-header">

        <div class="dashboard-title">
            <h1>SDN Operations Dashboard</h1>
            <p>Monitor experiment execution, network performance and system readiness.</p>
        </div>

        <div class="live-indicator">
            <span class="live-dot"></span>
            <span>Live Monitoring</span>
        </div>

    </div>


    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Experiment Overview</h2>
            <span>Updated automatically</span>
        </div>

        <div class="overview-grid">

            <div class="status-card">
                <span class="label">Experiment Status</span>
                <div id="status" class="value">-</div>
            </div>

            <div class="status-card">
                <span class="label">Current Stage</span>
                <div id="stage" class="value small">-</div>
            </div>

            <div class="status-card">
                <span class="label">Experiment ID</span>
                <div id="experiment" class="value small">-</div>
            </div>

            <div class="status-card">
                <span class="label">Elapsed Time</span>
                <div class="value">
                    <span id="elapsed">0</span>s
                </div>
            </div>

            <div class="status-card">
                <span class="label">Hosts</span>
                <div id="hosts" class="value">-</div>
            </div>

            <div class="status-card">
                <span class="label">Switches</span>
                <div id="switches" class="value">-</div>
            </div>

            <div class="status-card">
                <span class="label">Flask API</span>
                <div id="flask" class="value small">-</div>
            </div>

            <div class="status-card">
                <span class="label">Controller</span>
                <div id="controller" class="value small">-</div>
            </div>

        </div>

    </section>


    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Live QoS Metrics</h2>
            <span>Current network measurements</span>
        </div>

        <div class="metrics-grid">

            <div class="metric-card">
                <span class="metric-label">Average RTT</span>
                <span class="metric-value">
                    <b id="rtt">-</b>
                </span>
                <span class="metric-unit">ms</span>
            </div>

            <div class="metric-card">
                <span class="metric-label">Jitter</span>
                <span class="metric-value">
                    <b id="jitter">-</b>
                </span>
                <span class="metric-unit">ms</span>
            </div>

            <div class="metric-card">
                <span class="metric-label">Throughput</span>
                <span class="metric-value">
                    <b id="throughput">-</b>
                </span>
                <span class="metric-unit">Mbps</span>
            </div>

            <div class="metric-card">
                <span class="metric-label">Packet Loss</span>
                <span class="metric-value">
                    <b id="loss">-</b>
                </span>
                <span class="metric-unit">%</span>
            </div>

        </div>

    </section>


    <section class="dashboard-section">

        <div class="dashboard-two-column">

            <div class="panel">

                <h2>🧪 Experiment Workflow</h2>

                <div class="workflow-list">

                    <div class="workflow-item">
                        <span>1. Environment Cleanup</span>
                        <b id="wf_cleanup">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>2. Topology Creation</span>
                        <b id="wf_topology">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>3. Controller Startup</span>
                        <b id="wf_controller">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>4. Mininet Deployment</span>
                        <b id="wf_mininet">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>5. Traffic Measurement</span>
                        <b id="wf_traffic">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>6. Metrics Collection</span>
                        <b id="wf_metrics">⏳ WAITING</b>
                    </div>

                    <div class="workflow-item">
                        <span>7. Finished</span>
                        <b id="wf_finished">⏳ WAITING</b>
                    </div>

                </div>

            </div>


            <div class="panel">

                <h2>⚙ System Runtime</h2>

                <div class="runtime-list">

                    <div class="runtime-item">
                        <span>Experiment Execution</span>
                        <b id="mininet">-</b>
                    </div>

                </div>

                <h2 style="margin-top:24px;">📦 Batch Execution</h2>

                <div class="batch-grid">

                    <div class="batch-item wide">
                        <span>Current Job</span>
                        <b id="batch_job">-</b>
                    </div>

                    <div class="batch-item">
                        <span>Status</span>
                        <b id="batch_status">-</b>
                    </div>

                    <div class="batch-item">
                        <span>Progress</span>
                        <b id="batch_progress">0</b>
                    </div>

                    <div class="batch-item">
                        <span>Successful</span>
                        <b id="batch_success">0</b>
                    </div>

                    <div class="batch-item">
                        <span>Failed</span>
                        <b id="batch_failed">0</b>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="dashboard-section">

        <div class="dashboard-two-column">

            <div class="panel">

                <h2>🟢 System Readiness</h2>

                <div id="readiness" class="readiness-box">
                    Checking system readiness...
                </div>

            </div>


            <div class="panel">

                <h2>📡 Monitoring</h2>

                <div class="runtime-list">

                    <div class="runtime-item">
                        <span>Live API Polling</span>
                        <b>ACTIVE</b>
                    </div>

                    <div class="runtime-item">
                        <span>System Monitoring</span>
                        <b>ACTIVE</b>
                    </div>

                    <div class="runtime-item">
                        <span>Batch Monitoring</span>
                        <b>ACTIVE</b>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="dashboard-section">

        <div class="panel">

            <div class="section-heading">
                <h2>📚 Experiment History</h2>
                <span>Latest experiment measurements</span>
            </div>

            <div class="history-wrapper">

                <table class="history-table">

                    <thead>
                        <tr>
                            <th>Experiment ID</th>
                            <th>Run</th>
                            <th>RTT</th>
                            <th>Throughput</th>
                            <th>Loss</th>
                            <th>MOS</th>
                            <th>Analytics</th>
                        </tr>
                    </thead>

                    <tbody id="experiment_history">

                        <tr>
                            <td colspan="7">
                                Loading experiment history...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</div>


<script>

function update(){

    fetch("/api/dashboard/live")

    .then(r => r.json())

    .then(data => {

        document.getElementById("status").innerHTML =
            data.status || "-";

        document.getElementById("stage").innerHTML =
            data.stage || "-";

        document.getElementById("experiment").innerHTML =
            data.experiment_id || "-";

        document.getElementById("hosts").innerHTML =
            data.hosts ?? "-";

        document.getElementById("switches").innerHTML =
            data.switches ?? "-";

        document.getElementById("elapsed").innerHTML =
            data.elapsed_seconds || 0;

        let m = data.metrics || {};

        document.getElementById("rtt").innerHTML =
            m.average_rtt ?? "-";

        document.getElementById("jitter").innerHTML =
            m.jitter ?? "-";

        document.getElementById("throughput").innerHTML =
            m.throughput ?? "-";

        document.getElementById("loss").innerHTML =
            m.packet_loss ?? "-";

    })

    .catch(() => {});

}


function updateSystem(){

    fetch("/api/dashboard/system")

    .then(r => r.json())

    .then(data => {

        document.getElementById("flask").innerHTML =
            data.flask && data.flask.running
            ? "🟢 RUNNING"
            : "🔴 STOPPED";

        document.getElementById("controller").innerHTML =
            data.controller && data.controller.running
            ? "🟢 RUNNING"
            : "🔴 STOPPED";

        document.getElementById("mininet").innerHTML =
            data.experiment &&
            data.experiment.status === "RUNNING"
            ? "🟢 RUNNING"
            : "⚪ IDLE";

    })

    .catch(() => {});

}


let currentJob = null;


function updateBatch(){

    if(!currentJob)
        return;

    fetch("/api/batch/status/" + currentJob)

    .then(r => r.json())

    .then(data => {

        let job = data.job;

        if(job){

            document.getElementById("batch_status").innerHTML =
                job.status || "-";

            document.getElementById("batch_progress").innerHTML =
                (job.current_run || 0) +
                "/" +
                (job.total_runs || 0);

            document.getElementById("batch_success").innerHTML =
                job.successful || 0;

            document.getElementById("batch_failed").innerHTML =
                job.failed || 0;

        }

    })

    .catch(() => {});

}


async function checkReadiness(){

    try{

        let r =
            await fetch("/api/readiness");

        let data =
            await r.json();

        let box =
            document.getElementById("readiness");

        if(data.ready){

            box.innerHTML =
                "🟢 SYSTEM READY<br>" +
                "API ✅<br>" +
                "Controller ✅<br>" +
                "OVS ✅<br>" +
                "Mininet ✅<br>" +
                "Database ✅";

        }
        else{

            box.innerHTML =
                "🔴 SYSTEM NOT READY<br>" +
                JSON.stringify(data.checks);

        }

    }

    catch(e){

        document.getElementById("readiness")
            .innerHTML =
            "🔴 ERROR CHECKING SYSTEM";

    }

}


function loadHistory(){

    fetch("/api/history")

    .then(r => r.json())

    .then(data => {

        let html = "";

        if(!data || data.length === 0){

            html =
                "<tr>" +
                "<td colspan='7'>" +
                "No experiment history available." +
                "</td>" +
                "</tr>";

        }
        else{

            data.forEach(x => {

                html +=
                    "<tr>" +
                    "<td>" +
                    (x.experiment_id || "-") +
                    "</td>" +

                    "<td>" +
                    (x.run_number ?? "-") +
                    "</td>" +

                    "<td>" +
                    (x.rtt ?? "-") +
                    "</td>" +

                    "<td>" +
                    (x.throughput ?? "-") +
                    "</td>" +

                    "<td>" +
                    (x.loss ?? "-") +
                    "</td>" +

                    "<td>" +
                    (x.mos ?? "-") +
                    "</td>" +

                    "<td>" +
                    "<a target='_blank' href='/analytics/" +
                    x.experiment_id +
                    "'>View</a>" +
                    "</td>" +

                    "</tr>";

            });

        }

        document.getElementById(
            "experiment_history"
        ).innerHTML = html;

    })

    .catch(() => {});

}


update();
updateSystem();
checkReadiness();
loadHistory();

setInterval(update, 2000);
setInterval(updateSystem, 3000);
setInterval(updateBatch, 3000);
setInterval(checkReadiness, 5000);
setInterval(loadHistory, 5000);

</script>

{% endblock %}
