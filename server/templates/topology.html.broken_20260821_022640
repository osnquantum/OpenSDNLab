function getNextSwitchPort(switchId){

    let usedPorts = [];

    topologyState.links.forEach(function(link){

        if(
            link.source === switchId &&
            link.source_port !== null &&
            link.source_port !== undefined
        ){

            usedPorts.push(link.source_port);

        }

        if(
            link.target === switchId &&
            link.destination_port !== null &&
            link.destination_port !== undefined
        ){

            usedPorts.push(link.destination_port);

        }

    });

    let port = 1;

    while(usedPorts.includes(port)){

        port++;

    }

    return port;
}


function createLink(source,target){

    console.log(
        "LINK REQUEST:",
        source,
        target
    );

    let sourceNode =
        document.getElementById(source);

    let targetNode =
        document.getElementById(target);

    if(!sourceNode || !targetNode){

        console.warn("Invalid nodes");
        return;

    }

    let sourceIsHost =
        sourceNode.classList.contains("host");

    let targetIsHost =
        targetNode.classList.contains("host");

    let sourceIsSwitch =
        sourceNode.classList.contains("switch");

    let targetIsSwitch =
        targetNode.classList.contains("switch");

    /*
     * Only these connections are allowed:
     *
     * HOST   <-> SWITCH
     * SWITCH <-> SWITCH
     *
     * HOST <-> HOST is NOT allowed.
     */
    if(
        (sourceIsHost && targetIsHost) ||
        (!sourceIsHost && !sourceIsSwitch) ||
        (!targetIsHost && !targetIsSwitch)
    ){

        console.warn(
            "Invalid topology link:",
            source,
            target
        );

        return;

    }

    /*
     * A host can have only ONE link.
     *
     * This prevents:
     *
     * h1 -> s1   OK
     * h1 -> s2   NOT ALLOWED
     *
     * Switches may have multiple links.
     */
    if(sourceIsHost || targetIsHost){

        let hostId =
            sourceIsHost
                ? source
                : target;

        let hostAlreadyConnected =
            topologyState.links.some(
                function(link){

                    return (
                        link.source === hostId ||
                        link.target === hostId
                    );

                }
            );

        if(hostAlreadyConnected){

            console.warn(
                "Host already has a connection:",
                hostId
            );

            return;

        }

    }

    /*
     * Prevent duplicate links.
     */
    let exists =
        topologyState.links.some(
            l =>
            (l.source===source &&
             l.target===target)
            ||
            (l.source===target &&
             l.target===source)
        );

    if(exists){

        console.warn(
            "Link already exists:",
            source,
            target
        );

        return;

    }

    /*
     * Allocate switch ports.
     */
    let sourcePort =
        sourceIsSwitch
            ? getNextSwitchPort(source)
            : null;

    let destinationPort =
        targetIsSwitch
            ? getNextSwitchPort(target)
            : null;

    /*
     * Store link in topology JSON.
     */
    topologyState.links.push({

        source:source,

        target:target,

        source_port:sourcePort,

        destination_port:destinationPort

    });

    console.log(
        "LINK CREATED:",
        source,
        sourcePort,
        target,
        destinationPort
    );

    /*
     * Create visual jsPlumb connection.
     */
    let connection =
        jsPlumb.connect({

            source:source,

            target:target,

            anchors:[

                sourceIsHost
                    ? "Top"
                    : "AutoDefault",

                targetIsHost
                    ? "Top"
                    : "AutoDefault"

            ],

            endpoint:[
                "Dot",
                {
                    radius:3
                }
            ],

            endpointStyle:{
                fill:"#000000"
            },

            connector:[
                "Straight"
            ],

            paintStyle:{
                stroke:"#ffffff",
                strokeWidth:3
            }

        });

    /*
     * Delete Link Mode:
     * clicking the actual connection deletes it.
     */
    if(connection){

        connection.bind(
            "click",
            function(){

                if(!deleteLinkMode){

                    return;

                }

                deleteLink(
                    source,
                    target,
                    connection
                );

            }
        );

    }

    updateJSON();

}


function deleteLink(source,target,connection){

    console.log(
        "DELETE LINK:",
        source,
        target
    );

    /*
     * Remove link from topology JSON FIRST.
     *
     * This immediately releases its switch ports
     * because getNextSwitchPort() calculates ports
     * from topologyState.links.
     */
    topologyState.links =
        topologyState.links.filter(
            function(link){

                return !(
                    (link.source === source &&
                     link.target === target)
                    ||
                    (link.source === target &&
                     link.target === source)
                );

            }
        );

    /*
     * Remove visual jsPlumb connection.
     *
     * Take a snapshot because deleting connections
     * modifies jsPlumb's connection collection.
     */
    let connections =
        jsPlumb.getAllConnections().slice();

    connections.forEach(
        function(conn){

            let sourceId =
                typeof conn.source === "string"
                    ? conn.source
                    : conn.source.id;

            let targetId =
                typeof conn.target === "string"
                    ? conn.target
                    : conn.target.id;

            if(
                (sourceId === source &&
                 targetId === target)
                ||
                (sourceId === target &&
                 targetId === source)
            ){

                jsPlumb.deleteConnection(
                    conn
                );

            }

        }
    );

    updateJSON();

    console.log(
        "LINK DELETED AND PORTS RELEASED:",
        source,
        target
    );

}

