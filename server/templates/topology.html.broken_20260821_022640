        alert("Add at least one link.");
        return;
    }

    if(!runs || runs < 2){
        alert("Batch runs must be at least 2.");
        return;
    }

    const hosts =
        topologyState.nodes.filter(
            n => n.type === "host"
        ).length;

    const switches =
        topologyState.nodes.filter(
            n => n.type === "switch"
        ).length;

    try{

        /*
         * 1. Save topology.
         */
        const saveResponse = await fetch(
            "/api/topology/save",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    name: "custom_topology",
                    type: "custom",
                    controller: topologyState.controller,
                    nodes: topologyState.nodes,
                    links: topologyState.links
                })
            }
        );

        const saveData =
            await saveResponse.json();

        if(!saveResponse.ok || !saveData.success){
            throw new Error(
                saveData.message ||
                "Topology save failed"
            );
        }

        localStorage.setItem(
            "opensdnlab_topology_id",
            saveData.topology_id
        );


        /*
         * 2. Prepare experiment metadata.
         *    This DOES NOT start Mininet.
         */
        const prepareResponse = await fetch(
            "/api/experiments/prepare",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({

                    name: "Custom Batch Experiment",

                    topology: "custom",

                    topology_data: {
                        type: "custom",
                        nodes: topologyState.nodes,
                        links: topologyState.links,
                        controller: topologyState.controller,
                        hosts: hosts,
                        switches: switches
                    },

                    hosts: hosts,
                    switches: switches,

                    controller:
                        topologyState.controller,

                    protocol: "ipv4",

                    runs: runs
                })
            }
        );

        const prepareData =
            await prepareResponse.json();

        if(!prepareResponse.ok ||
           !prepareData.success){

            throw new Error(
                prepareData.message ||
                "Experiment preparation failed"
            );
        }

        const experimentId =
            prepareData.data?.experiment_id;

        if(!experimentId){
            throw new Error(
                "Experiment ID not returned"
            );
        }


        /*
         * 3. Create batch.
         */
        const batchResponse = await fetch(
            "/api/batch/create",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    experiment_id: experimentId,
                    runs: runs
                })
            }
        );

        const batchData =
            await batchResponse.json();

        if(!batchResponse.ok ||
           !batchData.success){

            throw new Error(
                batchData.message ||
                "Batch creation failed"
            );
        }

        const batchJobId =
            batchData.job?.job_id;

        if(!batchJobId){
            throw new Error(
                "Batch Job ID not returned"
            );
        }


        /*
         * 4. Start batch.
         */
        const startResponse = await fetch(
            "/api/batch/start/" + batchJobId,
            {
                method: "POST"
            }
        );

        const startData =
            await startResponse.json();

        if(!startResponse.ok ||
           !startData.success){

            throw new Error(
                startData.message ||
                "Batch failed to start"
            );
        }


        /*
         * 5. Same execution page.
         */
        window.location.href =
            "/running/" + batchJobId;

    }
    catch(error){

        console.error(
            "Batch start error:",
            error
        );

        alert(
            "Failed to start batch: " +
            error.message
        );
    }
}


