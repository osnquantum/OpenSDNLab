</style>



<div class="card">

<h2>
Interactive Topology
</h2>


<div id="editor">


<div id="h1"
class="device"
style="left:100px;top:100px">

h1

</div>


<div id="s1"
class="device switch"
style="left:300px;top:100px">

s1

</div>


<div id="c1"
class="device controller"
style="left:500px;top:100px">

Controller

</div>


</div>


</div>



<script>


jsPlumb.ready(function(){


jsPlumb.draggable(
[
"h1",
"s1",
"c1"
]
);



jsPlumb.connect({

source:"h1",

target:"s1",

connector:[
"Straight"
]

});


jsPlumb.connect({

source:"s1",

target:"c1",

connector:[
"Straight"
]

});


});


</script>


