<script src="/static/js/jsplumb.min.js">
/* =========================================================
   LOAD SAVED TOPOLOGY - SINGLE IMPLEMENTATION
========================================================= */

async function loadSavedTopology(topologyId){

    if(!topologyId){
        return;
    }

    try{

        const response = await fetch(
            "/api/topology/" +
            encodeURIComponent(topologyId)
        );

        const result = await response.json();

        if(
            !response.ok ||
            !result.success
        ){
            throw new Error(
                result.message ||
                "Failed to load topology"
            );
        }

        const topology = result.data;

        /*
         * Update topology state first.
         */
        topologyState.nodes =
            Array.isArray(topology.nodes)
                ? topology.nodes
                : [];

        topologyState.links =
            Array.isArray(topology.links)
                ? topology.links
                : [];

        topologyState.controller =
            topology.controller || "osken";


        /*
         * Restore controller selection.
         */
        const controller =
            document.getElementById("controller");

        if(controller){

            const savedController =
                String(
                    topologyState.controller
                ).toLowerCase();

            for(const option of controller.options){

                if(
                    option.value
                        .toLowerCase() ===
                    savedController
                ){

                    controller.value =
                        option.value;

                    break;
                }

            }

        }


        /*
         * Get canvas.
         */
        const canvas =
            document.getElementById("canvas");

        if(!canvas){
            throw new Error(
                "Topology canvas not found"
            );
        }


        /*
         * Remove existing jsPlumb connections.
         */
        if(
            typeof jsPlumb !== "undefined"
        ){

            try{
                jsPlumb.deleteEveryConnection();
            }
            catch(error){
                console.warn(
                    "Could not clear connections:",
                    error
                );
            }

        }


        /*
         * Remove existing topology nodes only.
         * Do NOT remove controllerNode if it exists.
         */
        canvas.querySelectorAll(
            ".device"
        ).forEach(function(node){

            node.remove();

        });


        /*
         * Recreate nodes.
         *
         * Copy the array because createNode()
         * uses topologyState.nodes to calculate
         * automatic positions.
         */
        const savedNodes =
            [...topologyState.nodes];

        savedNodes.forEach(function(node){

            createNode(
                node.id,
                node.type
            );

        });


        /*
         * Recreate topology links.
         */
        topologyState.links.forEach(
            function(link){

                if(
                    typeof createLink ===
                    "function"
                ){

                    createLink(
                        link.source,
                        link.target
                    );

                }
                else if(
                    typeof jsPlumb !==
                    "undefined"
                ){

                    jsPlumb.connect({

                        source:
                            link.source,

                        target:
                            link.target

                    });

                }

            }
        );


        /*
         * Refresh JSON preview.
         */
        if(
            typeof updateJSON ===
            "function"
        ){

            updateJSON();

        }


        /*
         * Save current loaded state locally.
         */
        localStorage.setItem(
            "opensdnlab_topology",
            JSON.stringify(topologyState)
        );

        localStorage.setItem(
            "opensdnlab_topology_id",
            topologyId
        );


        console.log(
            "Topology loaded and rendered:",
            topology
        );


        alert(
            "Topology loaded successfully."
        );

    }
    catch(error){

        console.error(
            "Topology load error:",
            error
        );

        alert(
            "Failed to load topology: " +
            error.message
        );

    }

}


</script>

<script>


let topologyState={

nodes:[],

links:[],

controller:"OS-Ken"

};



let hostCounter=0;

let switchCounter=0;

let linkMode=false;

let selectedNode=null;


let deleteMode=false;

let deleteLinkMode=false;





function getNextId(prefix){


    let i=1;


    while(
        document.getElementById(prefix+i)
    ){

        i++;

    }


    return i;

}



function addHost(){


hostCounter++;


let id="h"+hostCounter;


topologyState.nodes.push({

id:id,

type:"host"

});


createNode(id,"host");


updateJSON();


}




function addSwitch(){


switchCounter++;


let id="s"+switchCounter;


topologyState.nodes.push({

id:id,

type:"switch"

});


createNode(id,"switch");


updateJSON();


}




function createNode(id,type){

    let canvas=document.getElementById("canvas");

    let node=document.createElement("div");

    node.id=id;

    node.className="device "+type;

    node.innerHTML=id;

    /*
     * Position nodes according to their type.
     * Hosts are placed along the bottom.
     * Switches are placed above the hosts.
     */
    if(type==="host"){

        let index =
            topologyState.nodes.filter(
                n=>n.type==="host"
            ).length - 1;

        node.style.left =
            (50 + index*120)+"px";

        node.style.top =
            "100px";

    }
    else if(type==="switch"){

        let index =
            topologyState.nodes.filter(
                n=>n.type==="switch"
            ).length - 1;

        node.style.left =
            (200 + index*150)+"px";

        node.style.top =
            "300px";

    }

    canvas.appendChild(node);

    /*
     * Make the node draggable.
     */
    jsPlumb.draggable(node);

    /*
     * Connect the first switch to the controller.
     * This replaces the duplicated controller connection
     * blocks that existed in the previous function.
     */
    if(type==="switch"){

        let switches =
            topologyState.nodes.filter(
                n=>n.type==="switch"
            );

        if(switches.length===1){

            jsPlumb.connect({

                source:"controllerNode",

                target:id,

                connector:[
                    "Straight"
                ],

                paintStyle:{

                    stroke:"#ef4444",

                    strokeWidth:3,

                    dashstyle:"5 5"

                }

            });

        }

    }

    /*
     * Node click handling for link creation.
     */
    node.addEventListener(
        "click",
        function(e){

            if(!linkMode){

                return;

            }

            e.stopPropagation();

            console.log(
                "Selected node:",
                id
            );

            /*
             * First node:
             * highlight it and wait for the second node.
             */
            if(selectedNode === null){

                selectedNode = id;

                node.style.border =
                    "3px solid #facc15";

                node.style.boxShadow =
                    "0 0 12px rgba(250,204,21,0.8)";

                return;

            }

            /*
             * Clicking the same node again cancels
             * the current selection.
             */
            if(selectedNode === id){

                node.style.border = "";

                node.style.boxShadow = "";

                selectedNode = null;

                return;

            }

            /*
             * Second node:
             * create the link.
             */
            console.log(
                "Creating link:",
                selectedNode,
                id
            );

            createLink(
                selectedNode,
                id
            );

            /*
             * Clear first-node highlight.
             * Keep linkMode ACTIVE so another link
             * can be created immediately.
             */
            let first =
                document.getElementById(
                    selectedNode
                );

            if(first){

                first.style.border = "";

                first.style.boxShadow = "";

            }

            selectedNode = null;

        }
    );

    /*
     * Delete-mode handling.
     */
    node.onclick=function(e){

        if(deleteMode){

            deleteNode(id);

            e.stopPropagation();

        }

    };

}

function clearModeButtons(){

    let buttons = [
        "connectLinkBtn",
        "deleteNodeBtn",
        "deleteLinkBtn"
    ];

    buttons.forEach(function(id){

        let button =
            document.getElementById(id);

        if(button){

            button.classList.remove("active");

            button.style.background = "";

            button.style.color = "";

            button.style.borderColor = "";

        }

    });

}


function clearNodeSelection(){

    document
        .querySelectorAll(".device")
        .forEach(function(node){

            node.style.border = "";

            node.style.boxShadow = "";

        });

    selectedNode = null;

}


function setMode(mode){

    /*
     * Only ONE editing mode can be active.
     */
    linkMode = false;

    deleteMode = false;

    deleteLinkMode = false;

    clearNodeSelection();

    clearModeButtons();

    /*
     * Activate requested mode.
     */
    if(mode === "link"){

        linkMode = true;

        let button =
            document.getElementById(
                "connectLinkBtn"
            );

        if(button){

            button.classList.add("active");

            button.style.background =
                "#2563eb";

            button.style.color =
                "#ffffff";

            button.style.borderColor =
                "#2563eb";

        }

    }

    else if(mode === "deleteNode"){

        deleteMode = true;

        let button =
            document.getElementById(
                "deleteNodeBtn"
            );

        if(button){

            button.classList.add("active");

            button.style.background =
                "#dc2626";

            button.style.color =
                "#ffffff";

            button.style.borderColor =
                "#dc2626";

        }

    }

    else if(mode === "deleteLink"){

        deleteLinkMode = true;

        let button =
            document.getElementById(
                "deleteLinkBtn"
            );

        if(button){

            button.classList.add("active");

            button.style.background =
                "#dc2626";

            button.style.color =
                "#ffffff";

            button.style.borderColor =
                "#dc2626";

        }

    }

}


function enableLinkMode(){

    if(linkMode){

        setMode(null);

    }
    else{

        setMode("link");

    }

}


function enableDeleteMode(){

    if(deleteMode){

        setMode(null);

    }
    else{

        setMode("deleteNode");

    }

}


function enableDeleteLinkMode(){

    if(deleteLinkMode){

        setMode(null);

    }
    else{

        setMode("deleteLink");

    }

}


function deleteNode(id){

    console.log(
        "DELETE NODE:",
        id
    );

    /*
     * Remove every visual jsPlumb connection
     * attached to this node.
     */
    /*
     * Take a snapshot first.
     *
     * Do NOT delete while iterating directly over
     * jsPlumb.getAllConnections(), because deleting a
     * connection changes that collection.
     */
    let connections =
        jsPlumb.getAllConnections().slice();

    connections.forEach(
        function(connection){

            let sourceId =
                typeof connection.source === "string"
                    ? connection.source
                    : connection.source.id;

            let targetId =
                typeof connection.target === "string"
                    ? connection.target
                    : connection.target.id;

            if(
                sourceId === id ||
                targetId === id
            ){

                console.log(
                    "Removing connection:",
                    sourceId,
                    "->",
                    targetId
                );

                jsPlumb.deleteConnection(
                    connection
                );

            }

        }
    );

    /*
     * Remove node from topology JSON.
     */
    topologyState.nodes =
        topologyState.nodes.filter(
            function(node){

                return node.id !== id;

            }
        );

    /*
     * Remove all links attached to this node.
     */
    topologyState.links =
        topologyState.links.filter(
            function(link){

                return (
                    link.source !== id &&
                    link.target !== id
                );

            }
        );

    /*
     * Remove node from canvas.
     */
    let node =
        document.getElementById(id);

    if(node){

        node.remove();

    }

    /*
     * Exit node-delete mode.
     */
    deleteMode = false;

    updateJSON();

    console.log(
        "NODE DELETED:",
        id
    );

}

